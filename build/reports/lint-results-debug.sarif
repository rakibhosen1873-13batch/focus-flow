                    "rules": [
                        {
                            "id": "GestureBackNavigation",
                            "shortDescription": {
                                "text": "Usage of KeyEvent.KEYCODE_BACK"
                            },
                            "fullDescription": {
                                "text": "For apps targeting and running on Android 16+ (API 36+), predictive back animations are enabled by default. A back gesture does not trigger {Activity,Dialog}.onBackPressed, and does not dispatch KeyEvent.KEYCODE_BACK.\n\nApps should migrate to AndroidX's backward compatible OnBackPressedDispatcher.\n\nThis lint check does not consider per-activity opt-in/opt-out, so you may need to suppress or baseline reported incidents if migrating per-activity.",
                                "markdown": "For apps targeting and running on Android 16+ (API 36+), predictive back animations are enabled by default. A back gesture does not trigger `{Activity,Dialog}.onBackPressed`, and does not dispatch `KeyEvent.KEYCODE_BACK`.\n\nApps should migrate to AndroidX's backward compatible `OnBackPressedDispatcher`.\n\nThis lint check does not consider per-activity opt-in/opt-out, so you may need to suppress or baseline reported incidents if migrating per-activity."
                            },
                            "defaultConfiguration": {
                                "level": "warning",
                                "rank": 40
                            },
                            "properties": {
                                "tags": [
                                    "Correctness"
                                ]
                            }
                        },
                        {
                            "id": "MissingOnRenderProcessGone",
                            "shortDescription": {
                                "text": "WebViewClient does not implement onRenderProcessGone"
                            },
                            "fullDescription": {
                                "text": "If a WebView's render process is shut down, the app will crash unless the WebViewClient implements onRenderProcessGone and returns true. It is highly recommended to handle this callback.",
                                "markdown": "If a WebView's render process is shut down, the app will crash unless the WebViewClient implements `onRenderProcessGone` and returns `true`. It is highly recommended to handle this callback."
                            },
                            "defaultConfiguration": {
                                "level": "warning",
                                "rank": 60
                            },
                            "properties": {
                                "tags": [
                                    "Correctness"
                                ]
                            }
                        },
                        {
                            "id": "SetJavaScriptEnabled",
                            "shortDescription": {
                                "text": "Using setJavaScriptEnabled",
                                "markdown": "Using `setJavaScriptEnabled`"
                            },
                            "fullDescription": {
                                "text": "Your code should not invoke setJavaScriptEnabled if you are not sure that your app really requires JavaScript support.",
                                "markdown": "Your code should not invoke `setJavaScriptEnabled` if you are not sure that your app really requires JavaScript support."
                            },
                            "defaultConfiguration": {
                                "level": "warning",
                                "rank": 50
                            },
                            "properties": {
                                "tags": [
                                    "Security"
                                ]
                            }
                        }
                    ]
                }
            },
